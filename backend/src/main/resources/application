server:
  port: 8080

spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/loans}
    username: ${DB_USER:loans}
    password: ${DB_PASSWORD:loans}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: none
  flyway:
    enabled: true

app:
  jwt:
    secret: ${JWT_SECRET:dev-only-secret-dev-only-secret-dev-only}
    expiry-minutes: 480
  risk:
    decline-pd: 0.40
    refer-pd: 0.20
  llm:
    url: https://api.anthropic.com/v1/messages
    api-key: ${ANTHROPIC_API_KEY:}
    model: ${LLM_MODEL:claude-haiku-5-5}
